{
    "custom/arch": {
        "format": "",
        "exec": "echo \"$(whoami)@$(cat /etc/hostname)\"",
        "interval": "once",
        "tooltip-format": "{}",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menu/home.xml",
        "menu-actions": {
            "action-1": "hyprctl dispatch exec systemctl suspend",
            "action-2": "hyprctl dispatch exec poweroff",
            "action-3": "hyprctl dispatch exec reboot"
  		}
    },

    "idle_inhibitor": {
        "what": "idle",
        "format": "{icon}",
        "format-icons": {
            "activated": "󱙲",
            "deactivated": "󰍁"
        },
        "tooltip-format-activated": "<s>hypridle</s>",
        "tooltip-format-deactivated": "hypridle"
    },

    "backlight#icon": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": [
            "","","","","","","","","","","","","",""
        ],
        "format-full": "",
        "states": {
            "full": 100
        },
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1,
        "interval": "once",
        "tooltip": false
    },
    "backlight" : {
        "device": "intel_backlight",
        "format": "{percent}%",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1,
        "interval": "once",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": 10
        },
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "persistent": "",
            "empty": "",
            "urgent": "󰗖"
        },
        "max-width": 50,
        "on-click": "activate",
        "on-scroll-down": "",
        "on-scroll-up": ""
    },

    "memory#icon": {
        "format": "",
        "tooltip": false,
        "interval": "once"
    },
    "memory": {
        "format": "{percentage}%",
        "tooltip-format": " {used:2.1f} G /{total:2.1f} G\n󰾴 {swapUsed:2.1f} G / {swapTotal:2.1f} G",
        "interval": 10
    },

    "cpu#icon": {
        "format": "",
        "tooltip": false,
        "interval": "once"
    },
    "cpu": {
        "format": "{usage}%",
        "interval": 10
    },

    "temperature#icon": {
        "thermal-zone": 0,
        "tooltip": false,
        "format": "{icon}",
        "format-icons": ["","","","",""],
        "interval": 30
    },
    "temperature": {
        "thermal-zone": 0,
        "format": "{temperatureC}°C",
        "interval": 10
    },

    "clock": {
        "format": "󰥔 {:%F %T %Z}",
        "interval": 1,
        "tooltip": false
    },


    "network#wifi-icon": {
        "interface": "wlp*",
        "format": "{icon}",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "disconnected": "󰤭",
            "linked": "󱚾",
            "ethernet": ""
        },
        "tooltip-format": "{signalStrength}%",
        "on-click": "nm-connection-editor"
    },
    "network#wifi": {
        "interface": "wlp*",
        "format": "",
        "format-wifi": "{essid}",
        "format-linked": "connecting...",
        "format-disconnected": "disconnected",
        "tooltip-format": "{ipaddr}",
        "on-click": "nm-connection-editor",
        "tooltip": true
    },

    "network#eth5-icon": {
        "interface": "enp5*",
        "format": "{icon}",
        "format-icons": {
            "disconnected": "",
            "ethernet": "󰈀"
        },
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },
    "network#eth5": {
        "interface": "enp5*",
        "format": "",
        "format-ethernet": " {bandwidthDownBits}  {bandwidthUpBits}",
        "tooltip-format": "{ipaddr}",
        "on-click": "nm-connection-editor",
        "tooltip": true
    },

    "network#eth1-icon": {
        "interface": "enp1*",
        "format": "{icon}",
        "format-icons": {
            "disconnected": "",
            "ethernet": "󰈀"
        },
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },
    "network#eth1": {
        "interface": "enp1*",
        "format": "",
        "format-ethernet": " {bandwidthDownBits}  {bandwidthUpBits}",
        "tooltip-format": "{ipaddr}",
        "on-click": "nm-connection-editor",
        "tooltip": true
    },

    "pulseaudio#icon": {
        "format": "{icon}",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "headphone-muted": "󰟎",
            "headset-muted": "󰟎",
            "default": "󰕾",
            "default-muted": "󰖁",
            "bluetooth": "󰗾",
            "bluetooth-muted": "󰗿"
        },
        "on-click": "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 3
    },
    "pulseaudio": {
        "format-muted": "",
        "format": "{volume}%",
        "on-click": "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 3
    },

    "battery#icon": {
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-icons": [ "󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹" ],
        "format-full": "󰁹",
        "interval": 2
    },
    "battery": {
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-full": "100%",
        "interval": 10
    },

    "tray": {
        "icon-size": 20,
        "spacing": 2
    }
}